{
  "name": "dsh-browser-chat",
  "version": "1.1.0",
  "type": "module",
  "description": "Bridge a DeepSeek Harness session to the browser sidebar: HTTP + SSE, prompt/cancel, streaming replies.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "browser",
    "sidebar",
    "sse"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
